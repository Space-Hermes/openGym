+    const next = { ...prev, exerciseGoals: { seeded: { ...goal(), _ts: 50 } } }
+    stampPut(prev, next, { overRead: true, now: 50 })
+    expect(next.exerciseGoals.seeded._ts).toBe(50)
+    expect(goalsOf(mergeStates({ ...prev, _ts: 100 }, next))).toHaveLength(1)
+  })
+})
