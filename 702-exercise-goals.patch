+describe('goal sync', () => {
+  const change = (prev, now, fn) => { const next = structuredClone(prev); fn(next); next._ts = stampChange(prev, next, now); return next }
+  it('round-trips a calendar day and keeps a cleared date when an older device syncs', () => {
+    const base = { ...state(), exerciseGoals: { g: goal({ _ts: 20 }) }, _ts: 20 }
+    const dated = change(base, 30, s => { s.exerciseGoals.g.deadline = '2028-03-12' })
+    stampPut(base, dated, { overRead: true, now: 30 })
+    const roundTripped = mergeStates(base, JSON.parse(JSON.stringify(dated)))
+    expect(roundTripped.exerciseGoals.g.deadline).toBe('2028-03-12')
+    const cleared = change(roundTripped, 40, s => { s.exerciseGoals.g.deadline = '' })
+    stampPut(roundTripped, cleared, { overRead: true, now: 40 })
+    expect(mergeStates(dated, cleared).exerciseGoals.g.deadline).toBe('')
+  })
